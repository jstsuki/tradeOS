# Copy this file to ".env.local" for running on a computer,
# or enter these two values in Vercel > Project > Settings > Environment Variables.
# Both values are found in Supabase > Project Settings > API (or "Connect").
# Only use the PUBLIC "publishable" / "anon" key here. Never the secret / service_role key.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
